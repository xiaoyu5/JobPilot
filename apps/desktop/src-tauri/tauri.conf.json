{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobPilot",
  "version": "0.4.2",
  "identifier": "io.jobpilot.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run build:worker && npm run dev",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JobPilot · 本地求职工作台",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/jobpilot-node",
      "binaries/jobpilot-browser"
    ],
    "resources": {
      "resources/worker/": "worker/",
      "resources/notices/": "notices/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
