{
  "manifest_version": 3,
  "name": "JobPilot BOSS 只读连接",
  "version": "0.3.0",
  "description": "将 BOSS 当前渲染的业务标识提供给本机 JobPilot；可手动连接或自愿记住只读连接，不发送消息。",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": ["https://www.zhipin.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
